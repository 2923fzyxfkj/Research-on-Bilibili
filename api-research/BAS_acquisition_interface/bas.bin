/* Flappy Sina - script 1 (place at 0.1s): pause + title screen */
if (!Global._get("fs_running"))
{
    ScriptManager.clearTimer();
    ScriptManager.clearEl();
    ScriptManager.clearTrigger();
    $.frameRate = 24;

    var tMain = $.createComment("Flappy Sina", {x:0, y:0, lifeTime:0, fontsize:60, color:0xFFFFFF});
    tMain.x = (Player.width - tMain.width) / 2;
    tMain.y = Player.height * 0.25;

    var tPrompt = $.createComment("ÁÇπÂáªÊí≠ÊîæÈîÆÂºÄÂßãÊ∏∏Êàè", {x:0, y:0, lifeTime:0, fontsize:28, color:0xFFFF00});
    tPrompt.x = (Player.width - tPrompt.width) / 2;
    tPrompt.y = Player.height * 0.5;

    var tCredit = $.createComment("2026 bilibili@mtdcmz", {x:0, y:0, lifeTime:0, fontsize:16, color:0xFFFFFF});
    tCredit.x = (Player.width - tCredit.width) / 2;
    tCredit.y = Player.height * 0.85;

    Global._set("fs_tMain", tMain);
    Global._set("fs_tPrompt", tPrompt);
    Global._set("fs_tCredit", tCredit);

    Player.pause();
}
