function extract(data)
{
    data = (data.split("\r")).join("");
    data = (data.split("\n")).join("");

    var bmd = Bitmap.createBitmapData(1, 1);
    var output = bmd.getPixels(bmd.rect);
    output.clear();

    var dataBuffer = [];
    dataBuffer.length = 4;
    var outputBuffer = [];
    outputBuffer.length = 3;

    for (var i = 0; i < data.length; i += 4)
    {
        for (var j = 0; j < 4 && i + j < data.length; j++)
        {
            dataBuffer[j] = BASE64_CHARS.indexOf(data.charAt(i + j));
        }

        outputBuffer[0] = (dataBuffer[0] << 2) + ((dataBuffer[1] & 0x30) >> 4);
        outputBuffer[1] = ((dataBuffer[1] & 0x0f) << 4) + ((dataBuffer[2] & 0x3c) >> 2);
        outputBuffer[2] = ((dataBuffer[2] & 0x03) << 6) + dataBuffer[3];

        for (var k = 0; k < outputBuffer.length; k++)
        {
            if (dataBuffer[k + 1] == 64)
                break;
            output.writeByte(outputBuffer[k]);
        }
    }

    output.inflate();

    output.position = 0;

    return output;
}

function loadBitmapData(width, height, raw)
{
    var bmd = Bitmap.createBitmapData(width, height);
    bmd.setPixels(bmd.rect, extract(raw));
    return bmd;
}

/* game coords -> player coords (no canvas: every element sits on root) */
function updateViewTransform()
{
    var scaleX = Player.width / gameWidth;
    var scaleY = Player.height / gameHeight;
    if (scaleX < scaleY)
        gameScale = scaleX;
    else
        gameScale = scaleY;
    offX = (Player.width - gameWidth * gameScale) / 2;
    offY = (Player.height - gameHeight * gameScale) / 2;
}

function place(s, gx, gy, mul)
{
    s.scaleX = gameScale * mul;
    s.scaleY = gameScale * mul;
    s.x = offX + gx * gameScale;
    s.y = offY + gy * gameScale;
}

function createBird()
{
    var bmd = loadBitmapData(32, 32, RAW_bird);
    var shape = Bitmap.createBitmap({bitmapData:bmd, lifeTime:0});
    bird = {shape:shape, gx:birdStartX, gy:birdStartY};
    place(shape, bird.gx, bird.gy, birdSize / 32);
}

var pipeUpBmd;
var pipeDownBmd;
function preparePipes()
{
    pipeUpBmd = loadBitmapData(pipeWidth, pipeHeight, RAW_pipeUp);
    pipeDownBmd = loadBitmapData(pipeWidth, pipeHeight, RAW_pipeDown);
}

function createPipe()
{
    var gap = 150;
    var minPipeY = 100;
    var maxPipeY = 250;

    var pipeY = Math.floor(Math.random() * (maxPipeY - minPipeY) + minPipeY);

    var topPipe = Bitmap.createBitmap({bitmapData:pipeDownBmd, lifeTime:0});
    pipes.push({shape:topPipe, isTop:true, scored:false, gx:gameWidth, gy:pipeY - pipeHeight});
    place(topPipe, gameWidth, pipeY - pipeHeight, 1);

    var bottomPipe = Bitmap.createBitmap({bitmapData:pipeUpBmd, lifeTime:0});
    pipes.push({shape:bottomPipe, isTop:false, scored:false, gx:gameWidth, gy:pipeY + gap});
    place(bottomPipe, gameWidth, pipeY + gap, 1);

    /* later-created elements stack on top in this player, so rebuild the
       scoreboard after each pipe to keep it above bird and pipes */
    scoreText.remove();
    createScoreboard();
}

function createScoreboard()
{
    scoreText = $.createComment("Score: " + score, {x:0, y:0, lifeTime:0, fontsize:24, color:0xFFFFFF});
    scoreText.x = offX + 10 * gameScale;
    scoreText.y = offY + 10 * gameScale;
}

function drawOverScreen()
{
    var tOver = $.createComment("Game Over  Score: " + score, {x:0, y:0, lifeTime:0, fontsize:40, color:0xFF4040});
    tOver.x = (Player.width - tOver.width) / 2;
    tOver.y = Player.height * 0.35;

    var tPrompt = $.createComment("ÊåâÊí≠ÊîæÈîÆÈáçÊñ∞ÂºÄÂßã", {x:0, y:0, lifeTime:0, fontsize:28, color:0xFFFF00});
    tPrompt.x = (Player.width - tPrompt.width) / 2;
    tPrompt.y = Player.height * 0.5;

    overEls = [tOver, tPrompt];
}

function removeOverScreen()
{
    for (var i = overEls.length - 1; i >= 0; i--)
        overEls[i].remove();
    overEls = [];
}

function startRound()
{
    removeOverScreen();
    score = 0;
    scoreText.text = "Score: 0";
    birdVelocity = 0; /* clear leftover fall speed from the last round */
    createBird();
    createPipe();
    state = "playing";
}

function hookKeyboard()
{
    Player.keyTrigger(function(keyCode) {
        if (keyCode == Keyboard.A)
            keyA = true;
        if (keyCode == Keyboard.D)
            keyD = true;
        if (keyCode == Keyboard.W)
        {
            if (state == "playing")
                birdVelocity = birdJumpPower;
        }
    }, maxNum);
    Player.keyTrigger(function(keyCode) {
        if (keyCode == Keyboard.A)
            keyA = false;
        if (keyCode == Keyboard.D)
            keyD = false;
    }, maxNum, true);
}

function updatePipes()
{
    for (var i = pipes.length - 1; i >= 0; i--)
    {
        var p = pipes[i];
        p.gx -= pipeSpeed;
        place(p.shape, p.gx, p.gy, 1);

        if (p.gx + pipeWidth < 0)
        {
            p.shape.remove();
            pipes.splice(i, 1);
            continue;
        }

        /* bounding-box collision in game coords (same as flash hitTestObject) */
        if (bird.gx < p.gx + pipeWidth && bird.gx + birdSize > p.gx &&
            bird.gy < p.gy + pipeHeight && bird.gy + birdSize > p.gy)
        {
            gameOver();
            return;
        }

        if (p.isTop && !p.scored && p.gx + pipeWidth < bird.gx)
        {
            p.scored = true;
            score++;
            scoreText.text = "Score: " + score;
        }
    }

    if (pipes.length == 0 || pipes[pipes.length - 1].gx < gameWidth - 300)
        createPipe();
}

function updateGame()
{
    birdVelocity += birdGravity;
    bird.gy += birdVelocity;

    if (keyA)
        bird.gx -= birdHorizontalSpeed;
    if (keyD)
        bird.gx += birdHorizontalSpeed;
    place(bird.shape, bird.gx, bird.gy, birdSize / 32);

    if (bird.gy <= 0 || bird.gy + birdSize >= gameHeight)
    {
        gameOver();
        return;
    }

    updatePipes();
}

function gameOver()
{
    /* wipe the field, keep the scoreboard; freeze the video */
    for (var i = pipes.length - 1; i >= 0; i--)
        pipes[i].shape.remove();
    pipes = [];
    bird.shape.remove();

    drawOverScreen();
    state = "over";
    Player.pause();
}

function mainLoop()
{
    updateViewTransform();

    if (Player.state != "playing")
        return; /* paused -> freeze */

    if (state == "over")
    {
        /* user pressed play on the game-over screen -> new round */
        startRound();
        return;
    }

    updateGame();
}

if (!Global._get("fs_running"))
{
    Global._set("fs_running", true);
    updateViewTransform();
    createScoreboard();
    preparePipes();
    hookKeyboard();

    /* first fire at 0.2s: drop the script-1 title and play round 1 */
    var t = Global._get("fs_tMain");
    if (t != null) t.remove();
    t = Global._get("fs_tPrompt");
    if (t != null) t.remove();
    t = Global._get("fs_tCredit");
    if (t != null) t.remove();

    score = 0;
    createBird();
    createPipe();
    state = "playing";
    $.root.addEventListener("enterFrame", mainLoop);
}
